# AKSHARARECOVER AI — Frontend Environment Configuration
# Leave VITE_API_BASE_URL empty during local development to use the Vite dev proxy (/api -> http://127.0.0.1:8000)
# so HTTP-only session cookies work seamlessly on the same origin.
# In split-origin production deployments, set it to the public backend origin (e.g. https://api.akshararecover.org).
VITE_API_BASE_URL=
