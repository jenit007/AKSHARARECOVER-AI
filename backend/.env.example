# ============================================
# AksharaRecover AI - Environment Configuration
# ============================================
# Copy this file to .env and adjust values.
# Never commit .env to version control.

# Application
APP_NAME=AKSHARARECOVER_AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
PUBLIC_FRONTEND_URL=http://localhost:5173

# Authentication & Security
# Generate a strong random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Database (SQLite for dev, PostgreSQL for production)
# PostgreSQL example: postgresql://user:pass@localhost:5432/akshararecover
DATABASE_URL=sqlite:///./akshararecover.db

# Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=30
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,tif,tiff,pdf

# OCR Settings
# Engine: easyocr, paddleocr
OCR_ENGINE=easyocr
OCR_LANGUAGE=en
OCR_CONFIDENCE_THRESHOLD=0.70

# Translation Settings
# Engine: nllb, api, none
# Set to 'none' if transformers/NLLB weights are not installed
TRANSLATION_ENGINE=none
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_API_KEY=
TRANSLATION_API_URL=

# AI / Hardware
# Device: auto, cuda, cpu
AI_DEVICE=auto
AI_BATCH_SIZE=1

# CORS - comma-separated frontend origins allowed with credentials
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
